# --- Telegram ---
# Получить на https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789

# Номер аккаунта, под которым логинимся (с +)
TG_PHONE=+79991234567

# Путь к файлу сессии (без расширения). Telethon создаст файл .session
TG_SESSION_NAME=session/legalconsalt

# Только для прода (Railway/контейнеры): строковая сессия Telethon.
# Локально оставь пустым — используется файловая сессия после входа по коду.
# Сгенерировать: см. README (export_session).
# TG_STRING_SESSION=1ApWap...

# --- Источник заявок ---
# ID супергруппы (отрицательное число, начинается с -100...).
# Узнать можно через find_ids.py
TARGET_GROUP_ID=-1001234567890

# Username бота(-ов)-отправителя БЕЗ символа @, через запятую если их несколько.
# Например: zayavki_bot,another_bot
SOURCE_BOT_USERNAMES=zayavki_bot,another_bot

# --- Trello ---
# Key и token: https://trello.com/power-ups/admin
TRELLO_KEY=your_trello_key
TRELLO_TOKEN=your_trello_token

# ID списка (колонки), куда падают новые заявки
TRELLO_LIST_ID=66a1b2c3d4e5f6789abcdef0
